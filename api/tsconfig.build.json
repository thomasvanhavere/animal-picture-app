{
  // ==========================================================================
  // tsconfig.build.json : compiler settings used by "npm run build"
  //
  // Same as tsconfig.json, but only compiles the application code in src/.
  // The tests in test/ are run directly by Vitest and never need to be
  // compiled to dist/, so they are left out here. This also keeps the
  // Docker image free of test code.
  // ==========================================================================
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Compile src/main.ts to dist/main.js, where package.json ("main") and
    // the Dockerfile look for it. tsconfig.json's rootDir "." (needed to also
    // cover test/) would put it at dist/src/main.js instead.
    "rootDir": "src"
  },
  "include": ["src"]
}
