    {
      "name": "Errors",
      "description": "Wrong requests, and what the API answers. Every error has the same JSON shape: `{ \"error\": \"...\", \"message\": \"...\" }`.",
      "item": [
        {
          "name": "Unknown animal (400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pictures?animal=fox",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pictures"
              ],
              "query": [
                {
                  "key": "animal",
                  "value": "fox"
                }
              ]
            },
            "description": "\"fox\" is not one of the known animals, so nothing is downloaded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 400 Bad Request', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('Bad Request');",
                  "});",
                  "",
                  "pm.test('explains what is wrong', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('\"fox\" is not a known animal. Choose one of: cat, dog, bear, random.');",
                  "});"
                ]
              }
            }
          ]
        },
