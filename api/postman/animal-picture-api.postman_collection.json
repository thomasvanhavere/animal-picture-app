                  "  pm.expect(pm.response.json().error).to.eql('Bad Request');",
                  "});",
                  "",
                  "pm.test('explains what is wrong', () => {",
                  "  pm.expect(pm.response.json().message).to.match(/^count must be between 1 and \\d+, but it is 1000\\.$/);",
                  "});"
                ]
              }
            }
