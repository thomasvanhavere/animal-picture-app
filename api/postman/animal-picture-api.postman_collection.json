                  "    pm.expect(picture.contentType).to.match(/^image\\//);",
                  "    pm.expect(picture.url).to.eql(`/api/pictures/${picture.id}`);",
                  "  }",
                  "});",
                  "",
                  "// Remember the newest picture, for \"One picture by id\".",
