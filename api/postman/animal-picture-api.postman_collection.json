    {
      "name": "Latest picture",
      "description": "The most recently saved picture, of any animal. Both answer `404` if nothing has been saved yet.",
      "item": [
        {
          "name": "Latest picture (as file)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pictures/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pictures",
                "latest"
              ]
            },
            "description": "Sends the newest saved picture as a file. Postman shows it in the response body, and a browser shows it directly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200 with a picture file', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//);",
                  "});",
                  "",
                  "pm.test('says how big the file is', () => {",
                  "  pm.expect(Number(pm.response.headers.get('Content-Length'))).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest picture (as JSON details)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pictures/latest/details",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pictures",
                "latest",
                "details"
              ]
            },
            "description": "The same picture, as JSON details instead of the file. This is what the web page's \"Latest saved picture\" panel uses."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200 with the picture details', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.all.keys('id', 'animal', 'provider', 'sourceUrl', 'contentType', 'sizeBytes', 'createdAt', 'url');",
                  "});",
                  "",
                  "pm.test('it is the picture saved last', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('pictureId')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
