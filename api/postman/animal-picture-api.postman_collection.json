          "name": "Count too high (400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pictures?count=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pictures"
              ],
              "query": [
                {
                  "key": "count",
                  "value": "1000"
                }
              ]
            },
            "description": "More than `MAX_PICTURES_PER_REQUEST` pictures in one request is refused."
