# =============================================================================
# .dockerignore : files that are NOT sent to Docker when building the image
#
# Docker starts a build by copying the whole folder. Leaving these out makes
# the build faster and keeps local-only things (installed packages, build
# output, secrets) from sneaking into the image. The Dockerfile installs and
# builds everything fresh.
# =============================================================================
node_modules
dist
coverage
test
*.log
.env
.env.*
