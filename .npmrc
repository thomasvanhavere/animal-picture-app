# =============================================================================
# .npmrc : npm settings for this project
#
# npm reads this file automatically whenever you run an npm command inside
# the project folder.
# =============================================================================

# Refuse to install when the Node.js or npm version doesn't match the
# "engines" field in package.json. Without this, npm only prints a warning
# that is easy to miss, and you might later get confusing errors caused by
# using the wrong Node.js version.
engine-strict=true

# Always save exact dependency versions (for example "5.1.0" instead of
# "^5.1.0"). Everyone, and every Docker build, then gets exactly the same code.
save-exact=true
