# =============================================================================
# .env.defaults : the default settings for the animal-picture-app
#
# HOW TO USE THIS FILE
#   You don't need to do anything: these defaults are used automatically,
#   both by Docker Compose and by "npm run dev:api". The app starts without
#   any other settings file.
#
#   To change a setting, DON'T edit this file. Instead, create a file called
#   ".env" in the same folder and put only the lines you want to change in
#   it, for example:
#
#     UI_PORT=8081
#     DEFAULT_ANIMAL=dog
#
#   A setting in ".env" wins over the same setting here. ".env" is ignored
#   by Git, so your own settings and passwords never end up in the
#   repository. This file IS saved in Git, so everyone gets working defaults
#   and can see which settings exist.
#
# HOW THE SETTINGS ARE NAMED
#   Every animal follows the same pattern:
#
#     <ANIMAL>_PROVIDER               which picture service to use right now
#     <ANIMAL>_PROVIDER_<NAME>_URL    the web address of one picture service
#     <ANIMAL>_PICTURE_WIDTH          picture width, in pixels
#     <ANIMAL>_PICTURE_HEIGHT         picture height, in pixels
#
#   The value of <ANIMAL>_PROVIDER must be one of the <NAME>s defined below it.
#   These names work like a list of allowed choices (an "enum"): when the API
#   starts, it checks every value and refuses to start with a clear message
#   if something is misspelled or missing.
#
#   Web addresses can contain two placeholders, which the app fills in on
#   every request. Both are optional; use only the ones a service needs.
#     {width}    replaced by <ANIMAL>_PICTURE_WIDTH
#     {height}   replaced by <ANIMAL>_PICTURE_HEIGHT
#
#   Example: with DOG_PICTURE_WIDTH=500 and DOG_PICTURE_HEIGHT=400,
#   https://place.dog/{width}/{height} becomes https://place.dog/500/400
# =============================================================================


# -----------------------------------------------------------------------------
# The web page (animal-picture-ui)
# -----------------------------------------------------------------------------

# The port the web page is opened on, on your machine:
# http://localhost:<UI_PORT>. Inside its container, the page always uses 8080.
UI_PORT=8080


# -----------------------------------------------------------------------------
# The API service
# -----------------------------------------------------------------------------

# The network port the API listens on. Also the port opened on your machine
# by docker-compose.yml, so the API is at http://localhost:<API_PORT>.
API_PORT=3000

# The most pictures one request may download at once. Protects the free
# picture services (and this app) from a request like "?count=100000".
MAX_PICTURES_PER_REQUEST=10

# How long to wait for a picture service to answer, in milliseconds, before
# giving up and reporting an error.
DOWNLOAD_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------
# The database (animal-picture-database)
# -----------------------------------------------------------------------------

# Where the API finds the database.
#   "localhost" is right when you run the API directly on your machine with
#   "npm run dev:api" and the database in Docker. Inside Docker Compose the API
#   uses the service name "animal-picture-database" instead; docker-compose.yml
#   sets that automatically, so you don't need to change this line.
DATABASE_HOST=localhost
DATABASE_PORT=5432

# The database name uses underscores, not hyphens: PostgreSQL only accepts a
# hyphen in a name if the name is quoted in every single query, which is
# easy to get wrong. The Docker service is still called animal-picture-database.
DATABASE_NAME=animal_picture_database
DATABASE_USER=animal_picture_user

# Fine for running on your own machine. Use a real password anywhere else.
DATABASE_PASSWORD=animal_picture_password


# -----------------------------------------------------------------------------
# General picture settings
# -----------------------------------------------------------------------------

# Which animals can be fetched. A comma-separated list.
# Allowed values: cat, dog, bear
ENABLED_ANIMALS=cat,dog,bear

# The animal used when a request doesn't say which one it wants.
# Allowed values: cat, dog, bear, random
#   "random" picks one of the ENABLED_ANIMALS each time.
DEFAULT_ANIMAL=random

# How many pixels the size may randomly grow, for every animal.
#
# Why? Some services (such as PlaceBear) choose their picture based on the
# size you ask for, so the same size always returns the same picture. Adding
# a few random pixels gives a different animal each time.
#
# Example: with CAT_PICTURE_WIDTH=500, CAT_PICTURE_HEIGHT=400 and a variation
# of 50, a cat picture is between 500 and 550 wide, and 400 and 450 high.
#
# Set to 0 to always use the exact sizes below. PlaceBear will then keep
# returning the same picture.
PICTURE_SIZE_VARIATION=50


# -----------------------------------------------------------------------------
# Cats
# -----------------------------------------------------------------------------

# Which cat picture service to use.
# Allowed values: cataas
#
# Cataas is the default: it's on the public-apis list, needs no account,
# and returns a different cat on every request.
CAT_PROVIDER=cataas

# Size of cat pictures, in pixels.
CAT_PICTURE_WIDTH=500
CAT_PICTURE_HEIGHT=400

# Cataas, "Cat as a service": https://cataas.com/
# Only the width is sent on purpose. If you also send a height, Cataas
# stretches the picture to fit, which makes the cat look squashed. With only
# a width, the height follows the picture's natural shape.
CAT_PROVIDER_CATAAS_URL=https://cataas.com/cat?width={width}


# -----------------------------------------------------------------------------
# Dogs
# -----------------------------------------------------------------------------

# Which dog picture service to use.
# Allowed values: placedog
DOG_PROVIDER=placedog

# Size of dog pictures, in pixels.
DOG_PICTURE_WIDTH=500
DOG_PICTURE_HEIGHT=400

# Place.dog: https://place.dog/
# Returns a different dog on every request, even for the same size.
DOG_PROVIDER_PLACEDOG_URL=https://place.dog/{width}/{height}


# -----------------------------------------------------------------------------
# Bears
# -----------------------------------------------------------------------------

# Which bear picture service to use.
# Allowed values: placebear
BEAR_PROVIDER=placebear

# Size of bear pictures, in pixels.
BEAR_PICTURE_WIDTH=500
BEAR_PICTURE_HEIGHT=400

# PlaceBear: https://placebear.com/
BEAR_PROVIDER_PLACEBEAR_URL=https://placebear.com/{width}/{height}


# =============================================================================
# ADDING MORE LATER
#
# More free picture services are listed at
# https://github.com/public-apis/public-apis (see the "Animals" section).
#
# Another service for an existing animal
#   Add a new <ANIMAL>_PROVIDER_<NAME>_URL line, add <NAME> (in lowercase) to
#   PROVIDERS_BY_ANIMAL in api/src/config/animals.ts, and to the "Allowed
#   values" comment above <ANIMAL>_PROVIDER here. Then select it with
#   <ANIMAL>_PROVIDER.
#   Example:
#     DOG_PROVIDER_RANDOMDOG_URL=https://...
#
# A new animal (for example a fox)
#   Add "fox" to ENABLED_ANIMALS, add FOX_PROVIDER, FOX_PROVIDER_<NAME>_URL,
#   FOX_PICTURE_WIDTH and FOX_PICTURE_HEIGHT lines, and add "fox" to the
#   Animal object and to PROVIDERS_BY_ANIMAL in api/src/config/animals.ts.
#   The web page has its own list too: add "fox" to ANIMAL_CHOICES in
#   ui/src/api/picture-api.ts, a radio button to ui/index.html, and
#   --color-fox (light and dark) and .animal-fox to ui/src/styles.css.
#
# Good to know
#   The services above return the picture itself. Many services on the
#   public-apis list instead return a small JSON text containing a link to
#   a picture (for example https://dog.ceo, or TheCatAPI at
#   https://api.thecatapi.com/v1/images/search). Supporting those needs one
#   extra piece of code that reads the link first, which can be added later.
# =============================================================================
